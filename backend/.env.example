# ============================================
# NER Logistics Intelligence — Backend Config
# ============================================

# Database
DATABASE_URL=sqlite:///./ner_logistics.db
# For production PostgreSQL+PostGIS:
# DATABASE_URL=postgresql://user:pass@host:5432/ner_logistics

# AI Provider: gemini | openai | demo
AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://nerlogistics.vercel.app

# External APIs (optional — uses demo data without)
WEATHER_API_KEY=
ROUTING_API_KEY=
DISASTER_API_KEY=

# App
APP_NAME=NER Logistics Intelligence API
APP_VERSION=1.0.0
DEBUG=true
DEMO_MODE=true
