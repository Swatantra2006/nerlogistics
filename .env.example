# Environment Variables for NER Logistics Intelligence Platform
# Copy this file to .env.local and fill in values

# AI Provider Configuration (optional - platform works with built-in neural engine without keys)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Backend API URL (optional - leave empty to use built-in Next.js serverless API routes)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Map Configuration (optional - uses OpenStreetMap by default)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Weather API (optional - uses synthetic data without)
WEATHER_API_KEY=

# Database (uses in-memory demo data by default)
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
