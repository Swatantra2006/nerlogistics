# ====================================================================
# NER Logistics Intelligence — Environment Variables
# Copy this file to .env.local and fill in values
# ====================================================================

# AI Provider Configuration
# The platform uses Google Gemini for conversational AI responses.
# Without a key, the system uses its built-in grounded routing engine (still accurate for route queries).
AI_PROVIDER=gemini
GEMINI_API_KEY=

# IMPORTANT: For Vercel deployment, set GEMINI_API_KEY in Vercel Dashboard:
#   Project Settings → Environment Variables → Add GEMINI_API_KEY
# The key is used SERVER-SIDE ONLY in the Next.js API route and is never exposed to the browser.

# Optional: OpenAI as alternative LLM
OPENAI_API_KEY=

# Backend API URL (optional — leave empty to use built-in Next.js serverless API routes)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Map Configuration (uses OpenStreetMap by default)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Weather API (optional — uses synthetic data without)
WEATHER_API_KEY=

# Database (uses in-memory demo data by default)
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
